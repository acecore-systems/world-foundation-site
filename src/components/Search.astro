---
import DefaultSearch from '@astrojs/starlight/components/Search.astro';
---

<DefaultSearch {...Astro.props} />

{/*
	The primary and pending semantic-search states keep Pagefind supplemental.
	`data-semantic-primary='true'` / `data-semantic-pending='true'` hide
	`.pagefind-ui__results-area` in src/styles/tailwind.css.
*/}

<template id="world-foundation-semantic-search">
	<p
		id="world-foundation-semantic-search-privacy"
		class="semantic-search__privacy"
		data-semantic-privacy
	>
	</p>
	<section class="semantic-search" data-semantic-search hidden>
		<div class="semantic-search__heading">
			<h2 data-semantic-heading></h2>
			<span aria-hidden="true">Vectorize</span>
		</div>
		<p
			class="semantic-search__status"
			data-semantic-status
			role="status"
			aria-live="polite"
		>
		</p>
		<ol class="semantic-search__results" data-semantic-results></ol>
	</section>
	<section class="network-search" data-network-search hidden>
		<div class="semantic-search__heading">
			<h2 data-network-heading></h2>
		</div>
		<ol class="semantic-search__results" data-network-results></ol>
	</section>
</template>

<script>
	import {
		fetchNetworkSearch,
		type NetworkSearchResult,
	} from '../scripts/network-search';
	import { isStrictUuid } from '../scripts/search-response-safety.ts';
	import { getSafeInternalUrl } from '../scripts/search-url-safety.ts';

	type SearchResult = {
		excerpt?: unknown;
		section?: unknown;
		title?: unknown;
		url?: unknown;
	};

	const translations = {
		ja: {
			heading: '意味の近い内容',
			networkHeading: 'Acecore関連サイト',
			searching: 'このサイトの公開資料を検索しています…',
			found: (count: number) =>
				'意味の近い資料が' + count + '件見つかりました。',
			viewResult: 'ページを見る',
			privacy:
				'検索語は、このサイトとAcecore関連サイトの公開情報を検索するために送信されます。個人情報・非公開情報は入力しないでください。',
		},
		en: {
			heading: 'Semantically related content',
			networkHeading: 'Related Acecore sites',
			searching: 'Searching this site’s public documents…',
			found: (count: number) =>
				count +
				' semantically related ' +
				(count === 1 ? 'document' : 'documents') +
				' found.',
			viewResult: 'View page',
			privacy:
				'Your query is sent to search this site and related Acecore public information. Do not enter personal or non-public information.',
		},
	} as const;

	const root = document.querySelector<HTMLElement>('site-search');
	const template = document.querySelector<HTMLTemplateElement>(
		'#world-foundation-semantic-search',
	);
	const container = root?.querySelector<HTMLElement>('.search-container');

	if (root && template && container && !root.dataset.semanticSearchReady) {
		root.dataset.semanticSearchReady = 'true';
		container.append(template.content.cloneNode(true));

		const panel = container.querySelector<HTMLElement>(
			'[data-semantic-search]',
		);
		const heading = panel?.querySelector<HTMLElement>(
			'[data-semantic-heading]',
		);
		const status = panel?.querySelector<HTMLElement>('[data-semantic-status]');
		const results = panel?.querySelector<HTMLOListElement>(
			'[data-semantic-results]',
		);
		const networkPanel = container.querySelector<HTMLElement>(
			'[data-network-search]',
		);
		const networkHeading = networkPanel?.querySelector<HTMLElement>(
			'[data-network-heading]',
		);
		const networkResults = networkPanel?.querySelector<HTMLOListElement>(
			'[data-network-results]',
		);
		const privacy = container.querySelector<HTMLElement>(
			'[data-semantic-privacy]',
		);
		const locale = document.documentElement.lang.toLowerCase().startsWith('en')
			? 'en'
			: 'ja';
		const copy = translations[locale];

		if (
			panel &&
			heading &&
			status &&
			results &&
			networkPanel &&
			networkHeading &&
			networkResults &&
			privacy
		) {
			heading.textContent = copy.heading;
			networkHeading.textContent = copy.networkHeading;
			privacy.textContent = copy.privacy;

			let debounceTimer: number | undefined;
			let activeController: AbortController | undefined;
			let networkController: AbortController | undefined;
			let requestSequence = 0;

			const revealPagefindFallback = () => {
				delete root.dataset.semanticPrimary;
				delete root.dataset.semanticPending;
			};

			const hideSemanticPanel = () => {
				panel.hidden = true;
				panel.removeAttribute('aria-busy');
				status.textContent = '';
				results.replaceChildren();
				revealPagefindFallback();
			};

			const showSemanticLoading = () => {
				delete root.dataset.semanticPrimary;
				root.dataset.semanticPending = 'true';
				panel.hidden = false;
				panel.setAttribute('aria-busy', 'true');
				results.replaceChildren();
				status.textContent = copy.searching;
			};

			const clearNetworkResults = () => {
				networkResults.replaceChildren();
				networkPanel.hidden = true;
			};

			const safeInternalHref = (value: unknown) =>
				getSafeInternalUrl(value, window.location.origin);

			const createSemanticResult = (item: SearchResult) => {
				const href = safeInternalHref(item?.url);
				if (typeof item?.title !== 'string' || !item.title.trim() || !href)
					return null;

				const link = document.createElement('a');
				link.href = href;
				link.className = 'semantic-search__result';

				const title = document.createElement('strong');
				title.textContent = item.title;
				link.append(title);

				if (
					typeof item.section === 'string' &&
					item.section.trim() &&
					item.section !== item.title
				) {
					const section = document.createElement('span');
					section.className = 'semantic-search__section';
					section.textContent = item.section;
					link.append(section);
				}

				if (typeof item.excerpt === 'string' && item.excerpt.trim()) {
					const excerpt = document.createElement('span');
					excerpt.className = 'semantic-search__excerpt';
					excerpt.textContent = item.excerpt;
					link.append(excerpt);
				}

				const listItem = document.createElement('li');
				listItem.append(link);
				return listItem;
			};

			const renderSemanticResults = (items: SearchResult[]) => {
				const rendered: HTMLLIElement[] = [];
				for (const item of items) {
					const listItem = createSemanticResult(item);
					if (listItem) rendered.push(listItem);
					if (rendered.length === 5) break;
				}

				results.replaceChildren(...rendered);
				panel.removeAttribute('aria-busy');
				if (rendered.length === 0) {
					hideSemanticPanel();
					return 0;
				}

				delete root.dataset.semanticPending;
				root.dataset.semanticPrimary = 'true';
				status.textContent = copy.found(rendered.length);
				panel.hidden = false;
				return rendered.length;
			};

			const createNetworkResult = (result: NetworkSearchResult) => {
				const link = document.createElement('a');
				link.href = result.url;
				link.target = '_blank';
				link.rel = 'noopener noreferrer';
				link.className = 'semantic-search__result';

				const title = document.createElement('strong');
				title.textContent = result.title;
				link.append(title);

				const source = document.createElement('span');
				source.className = 'network-search__source';
				source.textContent = result.sourceLabel;
				link.append(source);

				if (result.section && result.section !== result.title) {
					const section = document.createElement('span');
					section.className = 'semantic-search__section';
					section.textContent = result.section;
					link.append(section);
				}

				if (result.excerpt) {
					const excerpt = document.createElement('span');
					excerpt.className = 'semantic-search__excerpt';
					excerpt.textContent = result.excerpt;
					link.append(excerpt);
				}

				const viewResult = document.createElement('span');
				viewResult.className = 'network-search__link';
				viewResult.textContent = copy.viewResult;
				link.append(viewResult);

				const listItem = document.createElement('li');
				listItem.append(link);
				return listItem;
			};

			const renderNetworkResults = (items: NetworkSearchResult[]) => {
				const rendered = items.slice(0, 3).map(createNetworkResult);
				networkResults.replaceChildren(...rendered);
				networkPanel.hidden = rendered.length === 0;
			};

			const runNetworkSearch = (query: string, sequence: number) => {
				networkController?.abort();
				const controller = new AbortController();
				networkController = controller;
				const timeout = window.setTimeout(() => controller.abort(), 8_000);

				void fetchNetworkSearch(query, 'world-foundation', controller.signal)
					.then((items) => {
						if (
							controller === networkController &&
							sequence === requestSequence
						) {
							renderNetworkResults(items);
						}
					})
					.catch(() => {
						// Related-site search is supplemental and must not affect local search.
					})
					.finally(() => {
						window.clearTimeout(timeout);
						if (controller === networkController) networkController = undefined;
					});
			};

			const runSearch = async (query: string, sequence: number) => {
				if (sequence !== requestSequence) return;
				activeController?.abort();
				const controller = new AbortController();
				activeController = controller;
				const timeout = window.setTimeout(() => controller.abort(), 8_000);

				const startNetworkSearch = () => {
					if (
						sequence !== requestSequence ||
						controller !== activeController ||
						controller.signal.aborted
					) {
						return;
					}

					runNetworkSearch(query, sequence);
				};

				try {
					const response = await fetch('/api/search', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'X-World-Foundation-Search-Client': getSearchClientId(),
						},
						body: JSON.stringify({ query, locale }),
						credentials: 'same-origin',
						signal: controller.signal,
					});

					if (sequence !== requestSequence || controller !== activeController)
						return;
					if (!response.ok) {
						hideSemanticPanel();
						startNetworkSearch();
						return;
					}

					const payload: unknown = await response.json();
					if (sequence !== requestSequence || controller !== activeController)
						return;
					if (
						!payload ||
						typeof payload !== 'object' ||
						Array.isArray(payload) ||
						!('ok' in payload) ||
						payload.ok !== true ||
						!('requestId' in payload) ||
						!isStrictUuid(payload.requestId) ||
						!('results' in payload) ||
						!Array.isArray(payload.results)
					) {
						hideSemanticPanel();
						startNetworkSearch();
						return;
					}

					renderSemanticResults(payload.results as SearchResult[]);
					startNetworkSearch();
				} catch {
					if (sequence === requestSequence && controller === activeController) {
						hideSemanticPanel();
						startNetworkSearch();
					}
				} finally {
					window.clearTimeout(timeout);
					if (activeController === controller) activeController = undefined;
				}
			};

			const cancelPendingSearch = () => {
				window.clearTimeout(debounceTimer);
				debounceTimer = undefined;
				requestSequence += 1;
				activeController?.abort();
				activeController = undefined;
				networkController?.abort();
				networkController = undefined;
				hideSemanticPanel();
				clearNetworkResults();
			};

			const bindInput = (input: HTMLInputElement) => {
				if (input.dataset.semanticSearchBound) return;
				input.dataset.semanticSearchBound = 'true';
				const descriptions = new Set(
					(input.getAttribute('aria-describedby') || '')
						.split(/\s+/u)
						.filter(Boolean),
				);
				descriptions.add(privacy.id);
				input.setAttribute('aria-describedby', [...descriptions].join(' '));

				let isComposing = false;
				const scheduleSearch = () => {
					cancelPendingSearch();
					const query = normalizeQuery(input.value);
					if ([...query].length < 2) return;

					const sequence = requestSequence;
					showSemanticLoading();
					debounceTimer = window.setTimeout(
						() => void runSearch(query, sequence),
						450,
					);
				};

				input.addEventListener('compositionstart', () => {
					isComposing = true;
					cancelPendingSearch();
				});
				input.addEventListener('compositionend', () => {
					isComposing = false;
					scheduleSearch();
				});
				input.addEventListener('input', (event) => {
					if (isComposing || (event as InputEvent).isComposing) return;
					scheduleSearch();
				});
			};

			const bindPagefindInput = () => {
				const input = root.querySelector<HTMLInputElement>(
					'.pagefind-ui__search-input',
				);
				if (input) bindInput(input);
			};

			bindPagefindInput();
			const observer = new MutationObserver(bindPagefindInput);
			observer.observe(container, { childList: true, subtree: true });

			root
				.querySelector('dialog')
				?.addEventListener('close', cancelPendingSearch);
			window.addEventListener(
				'pagehide',
				() => {
					cancelPendingSearch();
					observer.disconnect();
				},
				{ once: true },
			);
		}
	}

	function normalizeQuery(value: string): string {
		return value.normalize('NFKC').replace(/\s+/gu, ' ').trim();
	}

	function getSearchClientId(): string {
		const key = 'world-foundation-search-client';
		try {
			const current = sessionStorage.getItem(key);
			if (current) return current;
			const created = crypto.randomUUID();
			sessionStorage.setItem(key, created);
			return created;
		} catch {
			return crypto.randomUUID();
		}
	}
</script>
