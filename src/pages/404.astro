---
import '../styles/tailwind.css';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>404 | World Foundation Design</title>
	</head>
	<body class="m-0 grid min-h-screen place-items-center bg-wf-404-canvas p-6 font-wf-system text-wf-404-text">
		<main class="w-full max-w-[680px]">
			<h1>404</h1>
			<p class="leading-[1.8] text-wf-404-muted">
				ページが見つかりません。サイドバーまたは検索から目的の文書を探してください。
			</p>
			<p class="leading-[1.8] text-wf-404-muted">
				<a class="text-wf-404-link underline underline-offset-4" href={base}>World Foundation Design に戻る</a>
			</p>
		</main>
	</body>
</html>
